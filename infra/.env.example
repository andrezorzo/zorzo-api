# Copy to infra/.env for the local stack. Never commit infra/.env.
# It goes into DATABASE_URL as is, so use URL-safe characters only (no @ : / # % ?).
POSTGRES_PASSWORD=zorzo
# Seed of the daily IP salt (32+ characters); any local value works. Production must use its own secret.
SALT_SEED=local-salt-seed-change-me-0123456789
# Model providers (LLD "Environment variables"): the local profile needs none; set one to try OpenRouter.
# OPENROUTER_API_KEY=
# Alerts go to Telegram only in production; locally they are log lines.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# LangSmith traces of the API's answers, on only with a key; empty sends nothing.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
